# Copy this file to .env.local and fill in the values. .env.local is never committed.
# Add the same variables in your hosting dashboard (e.g. Vercel -> Settings -> Environment Variables).

# Email: every email the site sends goes through this SMTP account (src/lib/email/mailer.ts),
# including the Contact form's inquiries.
# The Gmail address that sends. Also the sender address.
SMTP_USER=denvolab@gmail.com
# A Google APP PASSWORD for that account (Google Account -> Security -> 2-Step Verification -> App passwords),
# not the normal Gmail password. Secret: never put it in code or commit it. Spaces are fine.
SMTP_PASS=
# The sender name people see in their inbox.
MAIL_FROM_NAME=Denvolab
# Optional, the defaults are Gmail's: smtp.gmail.com, port 465, TLS.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
