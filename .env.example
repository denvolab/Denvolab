# Copy this file to .env.local and fill in the values. .env.local is never committed.

# Contact form (src/components/sections/contact-form/actions.ts)
# Required: API key from resend.com -> API Keys.
RESEND_API_KEY=
# Optional: where inquiries are sent. Default: hello@denvolab.com
CONTACT_TO_EMAIL=
# Optional: the sender, on a domain verified in Resend.
# Example: Denvo Lab <inquiries@denvolab.com>
# Default: Resend's test sender (only delivers to the Resend account owner's email).
CONTACT_FROM_EMAIL=
